{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "make",
            "args": ["Debug", "-j$(nproc)"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Build (Release)",
            "type": "shell",
            "command": "make",
            "args": ["Release", "-j$(nproc)"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Run (Debug)",
            "type": "shell",
            "command": "./bin/Shifting-Sands-Ecosystem_debug",
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "Build (Debug)",
            "problemMatcher": []
        },
        {
            "label": "Apply addon patches (cross-platform only)",
            "type": "shell",
            "command": "./tools/apply_addon_patches.sh",
            "args": ["${env:OF_ROOT}", "--cross-platform-only"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Add GPL modification notices (dry run)",
            "type": "shell",
            "command": "python3",
            "args": ["tools/add_modification_notices.py", "--name", "YOUR NAME", "--dry-run"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}