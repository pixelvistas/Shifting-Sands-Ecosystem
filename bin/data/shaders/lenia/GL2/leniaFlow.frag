// LeniaLab, Flow-Lenia (Plantec et al. 2023; flowlenia.py as published):
//   F_c = sobel(U_c) (1 - alpha_c) - sobel(sum_c A_c) alpha_c,  alpha_c = clip((A_c / theta)^2, 0, 1)
// and the target of each cell's matter, mu = pos + clip(dt F, -(dd - sigma), dd - sigma),
// clipped to [sigma, size - sigma] with walls. Output: mu - pos (cells),
// channels 0 and 1 in rg / ba (pair 0) or channel 2 in rg (pair 1).
// Sobel as the published code: (1, 2, 1) smoothing, difference across +-1
// cell (8 x the slope), zero outside a walled world, wrapped on a torus.
// Lab terms: + edgeRepel * edgeWidth * sobel(mask) / 8 (inwards at the mask
// edge, cells per unit time) and, gradTarget 1, + gradStrength * long side
// * sobel(E) / 8 (drift up the gradient, cells per unit time).
// Keep in sync with ../GL3/leniaFlow.frag (generated by tools/lenia_lab/make_gl2.py).
#version 120
#extension GL_ARB_texture_rectangle : enable

uniform sampler2DRect stateTex;   // A
uniform sampler2DRect affTex;     // U (rgb)
uniform sampler2DRect envTex;
uniform vec2 worldSize;
uniform int wrapWorld;
uniform int pair;                 // 0: channels 0, 1; 1: channel 2
uniform float dt;
uniform float dd;
uniform float sigma;
uniform float theta;
uniform int maskMode;
uniform vec2 maskCentre;
uniform float maskRadius;
uniform float maskEdge;
uniform float edgeRepel;
uniform int gradMode;
uniform vec2 gradDir;
uniform float gradStrength;
uniform int gradTarget;

varying vec2 coord;

bool inside(vec2 c)
{
	return c.x >= 0.0 && c.y >= 0.0 && c.x < worldSize.x && c.y < worldSize.y;
}

vec4 fetchWorld(sampler2DRect t, vec2 c)
{
	if (wrapWorld == 1)
		c = mod(c, worldSize);
	else if (!inside(c))
		return vec4(0.0);
	return texture2DRect(t, c + 0.5);
}

float maskAt(vec2 c)
{
	if (maskMode == 1) {
		float d = length(c + 0.5 - maskCentre);
		return 1.0 - smoothstep(maskRadius - max(maskEdge, 0.001), maskRadius, d);
	}
	if (maskMode == 2)
		return clamp(texture2DRect(envTex, clamp(c, vec2(0.0), worldSize - 1.0) + 0.5).r, 0.0, 1.0);
	return 1.0;
}

float envAt(vec2 c)
{
	if (gradMode == 1)
		return clamp(0.5 + dot(c + 0.5 - 0.5 * worldSize, gradDir) / max(worldSize.x, worldSize.y), 0.0, 1.0);
	if (gradMode == 2)
		return clamp(texture2DRect(envTex, clamp(c, vec2(0.0), worldSize - 1.0) + 0.5).g, 0.0, 1.0);
	return 0.5;
}

void main()
{
	vec2 cell = floor(coord);
	// 3 x 3 neighbourhood: U (rgb), total A (a), mask, E
	vec4 sx = vec4(0.0), sy = vec4(0.0);      // sobel of (U0, U1, U2, sum A)
	vec2 sm = vec2(0.0), se = vec2(0.0);      // sobel of mask, E
	for (int j = -1; j <= 1; j++) {
		for (int i = -1; i <= 1; i++) {
			if (i == 0 && j == 0)
				continue;
			vec2 c = cell + vec2(float(i), float(j));
			vec4 a = fetchWorld(stateTex, c);
			vec4 v = vec4(fetchWorld(affTex, c).rgb, a.r + a.g + a.b);
			float wx = float(i) * (j == 0 ? 2.0 : 1.0);
			float wy = float(j) * (i == 0 ? 2.0 : 1.0);
			sx += wx * v;
			sy += wy * v;
			if (maskMode != 0 && edgeRepel != 0.0) {
				float m = maskAt(c);
				sm += vec2(wx, wy) * m;
			}
			if (gradMode != 0 && gradTarget == 1) {
				float e = envAt(c);
				se += vec2(wx, wy) * e;
			}
		}
	}
	vec4 A = texture2DRect(stateTex, cell + 0.5);
	vec3 alpha = clamp((A.rgb / theta) * (A.rgb / theta), 0.0, 1.0);
	vec2 extra = edgeRepel * max(maskEdge, 1.0) * sm / 8.0
		+ gradStrength * max(worldSize.x, worldSize.y) * se / 8.0;
	vec2 F0 = vec2(sx.x, sy.x) * (1.0 - alpha.r) - vec2(sx.w, sy.w) * alpha.r + extra;
	vec2 F1 = vec2(sx.y, sy.y) * (1.0 - alpha.g) - vec2(sx.w, sy.w) * alpha.g + extra;
	vec2 F2 = vec2(sx.z, sy.z) * (1.0 - alpha.b) - vec2(sx.w, sy.w) * alpha.b + extra;
	float ma = dd - sigma;
	vec2 pos = cell + 0.5;
	vec2 lo = vec2(sigma), hi = worldSize - sigma;
	vec2 d0 = clamp(dt * F0, -ma, ma);
	vec2 d1 = clamp(dt * F1, -ma, ma);
	vec2 d2 = clamp(dt * F2, -ma, ma);
	if (wrapWorld == 0) {
		d0 = clamp(pos + d0, lo, hi) - pos;
		d1 = clamp(pos + d1, lo, hi) - pos;
		d2 = clamp(pos + d2, lo, hi) - pos;
	}
	if (pair == 0)
		gl_FragColor = vec4(d0, d1);
	else
		gl_FragColor = vec4(d2, 0.0, 0.0);
}
