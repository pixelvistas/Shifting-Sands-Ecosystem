// LeniaLab: convolution and growth, one texel per world cell.
//   U_k = sum_taps w_k(tap) A_{from(k)}(x + tap)        (kernels k < nKernels, up to 12)
//   G_k = growth_gn(U_k; m_k, s_k)                       (gn 1 polynomial, 2 Gaussian, 3 step)
// mode 0, Lenia (Chan 2019; multi-kernel as LeniaNDKC.py):
//   A_c' = clip(A_c + dt [mask (sum_{k->c} h_k G_k / sum_{k->c} h_k) + (1 - mask) outside], 0, 1)
//   "relative" kernels (lab extension for cross kernels) add h_k (G_k - G_k(0))
//   and are left out of the sum of h.
//   plus the environment gradient (gradTarget 0: growth bias on occupied
//   cells; 1: advection of A along the gradient).
// mode 1, Flow-Lenia affinity (Plantec et al. 2023): U_c = mask sum_{k->c} h_k G_k
//   (x P_slot(k) with parameter embedding), plus gradStrength E (gradTarget 0).
// Taps: tapTex column t, row 0 = (dx, dy), rows 1..3 = weights of kernels 0-3, 4-7, 8-11.
// Kernel k reads channel from(k): (srcSel[i] * a)[j] = a[from(4i + j)];
// its h G goes to channel to(k): D += dstSel[i] * hG_i.
// Keep in sync with ../GL3/leniaConv.frag (generated by tools/lenia_lab/make_gl2.py).
#version 120
#extension GL_ARB_texture_rectangle : enable

uniform sampler2DRect stateTex;   // A: rgb = channels 0..2
uniform sampler2DRect tapTex;
uniform sampler2DRect paramTex;   // P: slot weights (parameter embedding)
uniform sampler2DRect envTex;     // r = painted mask, g = painted gradient
uniform vec2 worldSize;           // cells
uniform int wrapWorld;            // 1 torus, 0 wall (zero outside)
uniform int nTaps;
uniform int nKernels;
uniform mat4 srcSel0;
uniform mat4 srcSel1;
uniform mat4 srcSel2;
uniform mat4 dstSel0;
uniform mat4 dstSel1;
uniform mat4 dstSel2;
uniform mat4 slotSel0;            // kernel -> embedding slot (columns = slots)
uniform mat4 slotSel1;
uniform mat4 slotSel2;
uniform vec4 kM[3];
uniform vec4 kS[3];
uniform vec4 kH[3];
uniform vec4 kGn[3];
uniform vec4 kRel[3];             // 1: relative kernel
uniform int mode;                 // 0 Lenia, 1 Flow-Lenia affinity
uniform int embed;                // 1: weight h G by P (flow mode)
uniform float dt;
uniform vec3 channelOn;           // 1 for channels with kernels into them
// environment
uniform int maskMode;             // 0 none, 1 circle, 2 painted
uniform vec2 maskCentre;
uniform float maskRadius;
uniform float maskEdge;
uniform float outsideGrowth;      // Lenia: growth outside the mask (0 = none)
uniform int gradMode;             // 0 off, 1 linear, 2 painted
uniform vec2 gradDir;
uniform float gradStrength;
uniform int gradTarget;           // 0 growth / affinity bias, 1 advection (Lenia)

varying vec2 coord;

const int MAX_TAPS = 4096;

vec4 stateAt(vec2 c)
{
	if (wrapWorld == 1)
		c = mod(c, worldSize);
	else if (c.x < 0.0 || c.y < 0.0 || c.x >= worldSize.x || c.y >= worldSize.y)
		return vec4(0.0);
	return texture2DRect(stateTex, c + 0.5);
}

float maskAt(vec2 c)
{
	if (maskMode == 1) {
		float d = length(c + 0.5 - maskCentre);
		return 1.0 - smoothstep(maskRadius - max(maskEdge, 0.001), maskRadius, d);
	}
	if (maskMode == 2)
		return clamp(texture2DRect(envTex, clamp(c, vec2(0.0), worldSize - 1.0) + 0.5).r, 0.0, 1.0);
	return 1.0;
}

float envAt(vec2 c)
{
	if (gradMode == 1)
		return clamp(0.5 + dot(c + 0.5 - 0.5 * worldSize, gradDir) / max(worldSize.x, worldSize.y), 0.0, 1.0);
	if (gradMode == 2)
		return clamp(texture2DRect(envTex, clamp(c, vec2(0.0), worldSize - 1.0) + 0.5).g, 0.0, 1.0);
	return 0.5;
}

vec4 growth(vec4 u, vec4 m, vec4 s, vec4 gn)
{
	vec4 d = u - m;
	vec4 q = max(vec4(0.0), 1.0 - d * d / (9.0 * s * s));
	q = q * q;
	vec4 gPoly = 2.0 * q * q - 1.0;
	vec4 gGauss = 2.0 * exp(-d * d / (2.0 * s * s)) - 1.0;
	vec4 gStep = 2.0 * step(abs(d), s) - 1.0;
	vec4 isPoly = vec4(lessThan(abs(gn - 1.0), vec4(0.5)));
	vec4 isGauss = vec4(lessThan(abs(gn - 2.0), vec4(0.5)));
	vec4 isStep = vec4(lessThan(abs(gn - 3.0), vec4(0.5)));
	return isPoly * gPoly + isGauss * gGauss + isStep * gStep;
}

void main()
{
	vec2 cell = floor(coord);
	vec4 U0 = vec4(0.0);
	vec4 U1 = vec4(0.0);
	vec4 U2 = vec4(0.0);
	for (int t = 0; t < MAX_TAPS; t++) {
		if (t >= nTaps)
			break;
		float tx = float(t) + 0.5;
		vec4 off = texture2DRect(tapTex, vec2(tx, 0.5));
		vec4 a = stateAt(cell + off.xy);
		U0 += texture2DRect(tapTex, vec2(tx, 1.5)) * (srcSel0 * a);
		if (nKernels > 4)
			U1 += texture2DRect(tapTex, vec2(tx, 2.5)) * (srcSel1 * a);
		if (nKernels > 8)
			U2 += texture2DRect(tapTex, vec2(tx, 3.5)) * (srcSel2 * a);
	}
	vec4 hG0 = kH[0] * (growth(U0, kM[0], kS[0], kGn[0]) - kRel[0] * growth(vec4(0.0), kM[0], kS[0], kGn[0]));
	vec4 hG1 = kH[1] * (growth(U1, kM[1], kS[1], kGn[1]) - kRel[1] * growth(vec4(0.0), kM[1], kS[1], kGn[1]));
	vec4 hG2 = kH[2] * (growth(U2, kM[2], kS[2], kGn[2]) - kRel[2] * growth(vec4(0.0), kM[2], kS[2], kGn[2]));
	vec4 A = texture2DRect(stateTex, cell + 0.5);
	float m = maskAt(cell);
	float e = envAt(cell);
	if (mode == 1) {
		if (embed == 1) {
			vec4 P = texture2DRect(paramTex, cell + 0.5);
			hG0 *= slotSel0 * P;
			hG1 *= slotSel1 * P;
			hG2 *= slotSel2 * P;
		}
		vec4 U = dstSel0 * hG0 + dstSel1 * hG1 + dstSel2 * hG2;
		U *= m;
		if (gradMode != 0 && gradTarget == 0)
			U += vec4(channelOn, 0.0) * gradStrength * (e - 0.5);
		gl_FragColor = vec4(U.rgb, 0.0);
		return;
	}
	vec4 hR0 = kRel[0] * hG0;
	vec4 hR1 = kRel[1] * hG1;
	vec4 hR2 = kRel[2] * hG2;
	vec4 D = dstSel0 * (hG0 - hR0) + dstSel1 * (hG1 - hR1) + dstSel2 * (hG2 - hR2);
	vec4 Dn = dstSel0 * (kH[0] * (1.0 - kRel[0])) + dstSel1 * (kH[1] * (1.0 - kRel[1])) + dstSel2 * (kH[2] * (1.0 - kRel[2]));
	vec4 G = D / max(Dn, vec4(1e-6)) + dstSel0 * hR0 + dstSel1 * hR1 + dstSel2 * hR2;
	vec4 rate = m * G + (1.0 - m) * outsideGrowth;
	if (gradMode != 0) {
		if (gradTarget == 0) {
			// growth bias on occupied cells only (empty cells never start growing)
			rate += gradStrength * (e - 0.5) * smoothstep(vec4(0.0), vec4(0.1), A);
		} else {
			// advection with velocity v = gradStrength * grad E (E scaled so a
			// linear field has |grad E| = 1 / cell across the world's long side,
			// times that side: v is in cells per unit time, up the gradient):
			// dA/dt = -v . grad A, central differences
			vec2 v = gradStrength * 0.5 * max(worldSize.x, worldSize.y) *
				vec2(envAt(cell + vec2(1.0, 0.0)) - envAt(cell - vec2(1.0, 0.0)),
				     envAt(cell + vec2(0.0, 1.0)) - envAt(cell - vec2(0.0, 1.0)));
			vec4 ax = 0.5 * (stateAt(cell + vec2(1.0, 0.0)) - stateAt(cell - vec2(1.0, 0.0)));
			vec4 ay = 0.5 * (stateAt(cell + vec2(0.0, 1.0)) - stateAt(cell - vec2(0.0, 1.0)));
			rate -= v.x * ax + v.y * ay;
		}
	}
	vec3 on = channelOn;
	vec3 next = A.rgb + dt * rate.rgb * on;
	gl_FragColor = vec4(clamp(next, 0.0, 1.0), 0.0);
}
