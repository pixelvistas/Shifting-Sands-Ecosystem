// LeniaLab: block sums for the readouts. Each texel = the sum of a
// block x block block of world cells (rgb per channel, a = cells in the
// block that lie in the world), so the total mass per channel is the sum
// of this small texture and creatures can be counted on it (CPU).
// Keep in sync with ../GL3/leniaReduce.frag (generated by tools/lenia_lab/make_gl2.py).
#version 120
#extension GL_ARB_texture_rectangle : enable

uniform sampler2DRect stateTex;
uniform vec2 worldSize;
uniform float block;               // 1..8

varying vec2 coord;

void main()
{
	vec2 base = floor(coord) * block;
	vec3 sum = vec3(0.0);
	float n = 0.0;
	for (int y = 0; y < 8; y++) {
		if (float(y) >= block)
			break;
		for (int x = 0; x < 8; x++) {
			if (float(x) >= block)
				break;
			vec2 p = base + vec2(float(x), float(y));
			if (p.x < worldSize.x && p.y < worldSize.y) {
				sum += texture2DRect(stateTex, p + 0.5).rgb;
				n += 1.0;
			}
		}
	}
	gl_FragColor = vec4(sum, n);
}
