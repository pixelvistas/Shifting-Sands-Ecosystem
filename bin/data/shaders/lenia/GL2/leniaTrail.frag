// LeniaLab: short fading trail, one texel per output pixel:
// trail' = max(colour, decay * trail) per channel (decay = exp(-frame
// time / trail time)); trail' is what is shown.
// Keep in sync with ../GL3/leniaTrail.frag (generated by tools/lenia_lab/make_gl2.py).
#version 120
#extension GL_ARB_texture_rectangle : enable

uniform sampler2DRect colourTex;
uniform sampler2DRect trailTex;
uniform float decay;

varying vec2 coord;

void main()
{
	vec3 c = texture2DRect(colourTex, coord).rgb;
	vec3 t = texture2DRect(trailTex, coord).rgb;
	gl_FragColor = vec4(max(c, decay * t), 1.0);
}
