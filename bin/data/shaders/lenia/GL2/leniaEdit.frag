// LeniaLab: edits, one texel per world cell (display tools; a stand-in for
// a hand in the sand).
//   op 0 stamp:  A += stamp (a rotated/scaled pattern or noise patch, uploaded
//                by the CPU, origin = world cell of its texel (0, 0)).
//   op 1 add:    A_c += brushAmount * f(d) on the brush channels.
//   op 2 erase:  A *= 1 - brushAmount * f(d).
//   op 3 paint environment (envTex: r = mask, g = gradient): channel
//                envChannel moves to envValue by brushAmount * f(d).
// f(d) = (1 - (d / r)^2)^2 inside the brush radius r.
// target 0 writes A (clamped to 1 in Lenia mode), target 1 writes P: where
// matter is added with embedding, P moves to the slot's unit vector in
// proportion to the matter added (mass-weighted, as the "avg" mix).
// Keep in sync with ../GL3/leniaEdit.frag (generated by tools/lenia_lab/make_gl2.py).
#version 120
#extension GL_ARB_texture_rectangle : enable

uniform sampler2DRect stateTex;   // A (or envTex for op 3)
uniform sampler2DRect stampTex;
uniform sampler2DRect paramTex;
uniform vec2 worldSize;
uniform int op;
uniform int target;
uniform vec2 stampOrigin;
uniform vec2 stampSize;
uniform vec3 stampChannels;       // which channels of the stamp are applied
uniform vec2 brushCentre;         // cells
uniform float brushRadius;        // cells
uniform float brushAmount;
uniform vec3 brushChannels;
uniform int envChannel;           // 0 mask, 1 gradient
uniform float envValue;
uniform int clampOne;             // 1 in Lenia mode
uniform vec4 slotVec;             // embedding: the slot of the added matter

varying vec2 coord;

float falloff(vec2 c)
{
	float d = length(c + 0.5 - brushCentre) / max(brushRadius, 0.5);
	float q = max(0.0, 1.0 - d * d);
	return q * q;
}

void main()
{
	vec2 cell = floor(coord);
	vec4 A = texture2DRect(stateTex, cell + 0.5);
	if (op == 3) {
		float f = brushAmount * falloff(cell);
		if (envChannel == 0)
			A.r = mix(A.r, envValue, clamp(f, 0.0, 1.0));
		else
			A.g = mix(A.g, envValue, clamp(f, 0.0, 1.0));
		gl_FragColor = A;
		return;
	}
	vec3 add = vec3(0.0);
	vec3 next = A.rgb;
	if (op == 0) {
		vec2 s = cell - stampOrigin;
		if (s.x >= 0.0 && s.y >= 0.0 && s.x < stampSize.x && s.y < stampSize.y)
			add = texture2DRect(stampTex, s + 0.5).rgb * stampChannels;
		next = A.rgb + add;
	} else if (op == 1) {
		add = brushAmount * falloff(cell) * brushChannels;
		next = A.rgb + add;
	} else if (op == 2) {
		next = A.rgb * (1.0 - clamp(brushAmount * falloff(cell), 0.0, 1.0));
	}
	if (clampOne == 1)
		next = min(next, vec3(1.0));
	if (target == 0) {
		gl_FragColor = vec4(next, 0.0);
		return;
	}
	vec4 P = texture2DRect(paramTex, cell + 0.5);
	float before = A.r + A.g + A.b;
	float added = max(0.0, (next.r + next.g + next.b) - before);
	if (added > 0.0)
		P = (P * before + slotVec * added) / (before + added);
	gl_FragColor = P;
}
