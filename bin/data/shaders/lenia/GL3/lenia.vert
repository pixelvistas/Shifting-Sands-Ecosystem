// LeniaLab: pass-through vertex shader for every pass. texcoord is the
// pass's own texel coordinate (world cells or projector pixels). Keep in
// sync with ../GL2/lenia.vert (generated by tools/lenia_lab/make_gl2.py).
#version 150

uniform mat4 modelViewProjectionMatrix;

in vec4 position;
in vec2 texcoord;

out vec2 coord;

void main()
{
	coord = texcoord;
	gl_Position = modelViewProjectionMatrix * position;
}
