// LeniaLab, Flow-Lenia reintegration tracking (Plantec et al. 2023;
// reintegration_tracking.py as published): the matter of each source cell
// within dd is spread as a square of side 2 sigma centred at its target mu;
// a cell receives the overlap area / (4 sigma^2). Mass is conserved as
// long as every square lies inside the world (walls clip mu to
// [sigma, size - sigma]).
// target 0: the new A. target 1: the new parameter map P (embedding),
// mixed from the sources by mixRule 0 (mass-weighted average, the code's
// "avg") or 1 (one source picked with probability proportional to the
// matter it sends, the code's "stoch"; here a hash of cell and step).
// Keep in sync with ../GL2/leniaMove.frag (generated by tools/lenia_lab/make_gl2.py).
#version 150

uniform sampler2DRect stateTex;   // A
uniform sampler2DRect dispTex0;   // mu - pos, channels 0 (rg), 1 (ba)
uniform sampler2DRect dispTex1;   // mu - pos, channel 2 (rg)
uniform sampler2DRect paramTex;   // P
uniform vec2 worldSize;
uniform int wrapWorld;
uniform int dd;                   // 1..7
uniform float sigma;
uniform int target;
uniform int mixRule;
uniform float stepIndex;

in vec2 coord;
out vec4 outputColor;

vec2 overlap(vec2 delta)
{
	return clamp(0.5 + sigma - abs(delta), 0.0, min(1.0, 2.0 * sigma));
}

float hash(vec3 p)
{
	p = fract(p * vec3(0.1031, 0.1030, 0.0973));
	p += dot(p, p.yzx + 33.33);
	return fract((p.x + p.y) * p.z);
}

void main()
{
	vec2 cell = floor(coord);
	vec2 pos = cell + 0.5;
	float norm = 1.0 / (4.0 * sigma * sigma);
	vec3 sumA = vec3(0.0);
	vec4 sumP = vec4(0.0);
	float sumW = 0.0;
	vec4 pick = vec4(0.0);
	for (int j = -7; j <= 7; j++) {
		if (j < -dd || j > dd)
			continue;
		for (int i = -7; i <= 7; i++) {
			if (i < -dd || i > dd)
				continue;
			vec2 src = cell + vec2(float(i), float(j));
			if (wrapWorld == 1)
				src = mod(src, worldSize);
			else if (src.x < 0.0 || src.y < 0.0 || src.x >= worldSize.x || src.y >= worldSize.y)
				continue;
			vec4 a = texture(stateTex, src + 0.5);
			if (a.r + a.g + a.b <= 0.0)
				continue;
			vec4 d01 = texture(dispTex0, src + 0.5);
			vec2 d2 = texture(dispTex1, src + 0.5).rg;
			vec2 base = pos - (src + 0.5);
			if (wrapWorld == 1)
				base -= worldSize * floor(base / worldSize + 0.5);
			vec2 o0 = overlap(base - d01.xy);
			vec2 o1 = overlap(base - d01.zw);
			vec2 o2 = overlap(base - d2);
			vec3 got = a.rgb * vec3(o0.x * o0.y, o1.x * o1.y, o2.x * o2.y) * norm;
			sumA += got;
			if (target == 1) {
				float w = got.r + got.g + got.b;
				if (w > 0.0) {
					vec4 P = texture(paramTex, src + 0.5);
					sumP += w * P;
					sumW += w;
					// reservoir sampling: keep this source with probability w / sumW
					if (hash(vec3(cell, stepIndex + float(i * 31 + j))) * sumW < w)
						pick = P;
				}
			}
		}
	}
	if (target == 0) {
		outputColor = vec4(sumA, 0.0);
		return;
	}
	if (sumW <= 0.0)
		outputColor = vec4(0.0);
	else if (mixRule == 0)
		outputColor = sumP / sumW;
	else
		outputColor = pick;
}
