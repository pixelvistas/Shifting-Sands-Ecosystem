// LeniaLab: draws the field on black, one texel per output pixel.
// Field = mix(previous, current state, frac) (smooth motion between steps),
// sampled bilinearly. Each channel in its own colour, brightness
// clamp(gain A)^gamma; with parameter embedding, matter (channel 0) is
// coloured by its slot weights P. Optional soft glow (the field averaged on
// two rings of glowRadius / 2 and glowRadius cells), the mask edge and the
// gradient shown faintly for testing.
// Keep in sync with ../GL2/leniaRender.frag (generated by tools/lenia_lab/make_gl2.py).
#version 150

uniform sampler2DRect stateTex;
uniform sampler2DRect prevTex;
uniform sampler2DRect paramTex;
uniform sampler2DRect envTex;
uniform vec2 worldSize;           // cells
uniform vec2 outSize;             // pixels
uniform float frac;
uniform int embed;
uniform vec3 colour0;
uniform vec3 colour1;
uniform vec3 colour2;
uniform vec3 channelVisible;
uniform float gain;
uniform float gammaExp;
uniform float glowAmount;
uniform float glowRadius;         // cells
uniform int maskMode;
uniform vec2 maskCentre;
uniform float maskRadius;
uniform float maskEdge;
uniform float maskShow;           // brightness of the mask edge (0 off)
uniform int gradMode;
uniform vec2 gradDir;
uniform float gradShow;           // brightness of the gradient (0 off)

in vec2 coord;
out vec4 outputColor;

vec4 texel(sampler2DRect t, vec2 c)
{
	c = clamp(c, vec2(0.0), worldSize - 1.0);
	return texture(t, c + 0.5);
}

vec4 bilinear(sampler2DRect t, vec2 p)    // p in cells (continuous)
{
	vec2 q = p - 0.5;
	vec2 i = floor(q);
	vec2 f = q - i;
	return mix(mix(texel(t, i), texel(t, i + vec2(1.0, 0.0)), f.x),
	           mix(texel(t, i + vec2(0.0, 1.0)), texel(t, i + vec2(1.0, 1.0)), f.x), f.y);
}

vec4 field(vec2 p)
{
	return mix(bilinear(prevTex, p), bilinear(stateTex, p), frac);
}

vec3 tint(vec4 a, vec2 p)
{
	vec3 b = pow(clamp(gain * a.rgb, 0.0, 1.0), vec3(gammaExp)) * channelVisible;
	if (embed == 1) {
		vec4 P = bilinear(paramTex, p);
		float s = max(P.r + P.g + P.b, 1e-4);
		vec3 c = (P.r * colour0 + P.g * colour1 + P.b * colour2) / s;
		return b.r * c;
	}
	return b.r * colour0 + b.g * colour1 + b.b * colour2;
}

float maskAt(vec2 p)
{
	if (maskMode == 1)
		return 1.0 - smoothstep(maskRadius - max(maskEdge, 0.001), maskRadius, length(p - maskCentre));
	if (maskMode == 2)
		return clamp(bilinear(envTex, p).r, 0.0, 1.0);
	return 1.0;
}

void main()
{
	vec2 p = coord * worldSize / outSize;     // cells
	vec3 col = tint(field(p), p);
	if (glowAmount > 0.0 && glowRadius > 0.0) {
		vec3 g = vec3(0.0);
		for (int k = 0; k < 8; k++) {
			float a = float(k) * 0.785398 + 0.3927;
			vec2 d = vec2(cos(a), sin(a));
			g += tint(field(p + d * glowRadius * 0.5), p) * 0.6;
			g += tint(field(p + d * glowRadius), p) * 0.4;
		}
		col += glowAmount * g / 8.0;
	}
	if (maskShow > 0.0 && maskMode != 0) {
		float m = maskAt(p);
		float edge = 1.0 - abs(2.0 * m - 1.0);
		col += maskShow * edge * vec3(0.55, 0.55, 0.6);
	}
	if (gradShow > 0.0 && gradMode != 0) {
		float e;
		if (gradMode == 1)
			e = clamp(0.5 + dot(p - 0.5 * worldSize, gradDir) / max(worldSize.x, worldSize.y), 0.0, 1.0);
		else
			e = clamp(bilinear(envTex, p).g, 0.0, 1.0);
		col += gradShow * e * vec3(0.35, 0.3, 0.5);
	}
	outputColor = vec4(col, 1.0);
}
