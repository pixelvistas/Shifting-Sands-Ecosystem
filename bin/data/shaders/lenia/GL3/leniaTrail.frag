// LeniaLab: short fading trail, one texel per output pixel:
// trail' = max(colour, decay * trail) per channel (decay = exp(-frame
// time / trail time)); trail' is what is shown.
// Keep in sync with ../GL2/leniaTrail.frag (generated by tools/lenia_lab/make_gl2.py).
#version 150

uniform sampler2DRect colourTex;
uniform sampler2DRect trailTex;
uniform float decay;

in vec2 coord;
out vec4 outputColor;

void main()
{
	vec3 c = texture(colourTex, coord).rgb;
	vec3 t = texture(trailTex, coord).rgb;
	outputColor = vec4(max(c, decay * t), 1.0);
}
