// Prototype 2 (Mycorrhiza), style "Mycelium": bloom and exponential tone map
// Generated by tools/mycorrhiza_harness/gen_mycelium_shaders.py (edit there; GL2 and GL3 stay in sync).
// Port of tools/mycelium_lookdev/index.html (fsFinal); tools/mycorrhiza_harness/mycelium.cpp has the same formulas in C++.
#version 120
#extension GL_ARB_texture_rectangle : enable

uniform sampler2DRect uShade, uBloomA, uBloomB;
uniform vec2 uRes, uSizeA, uSizeB;
uniform float uBloom;

varying vec2 px;

void main()
{
	vec2 uv = px / uRes;
	vec3 c = texture2DRect(uShade, px).rgb + uBloom * (texture2DRect(uBloomA, uv * uSizeA).rgb + 0.6 * texture2DRect(uBloomB, uv * uSizeB).rgb);
	c = vec3(1.0) - exp(-c * 1.35);
	gl_FragColor = vec4(pow(c, vec3(0.95)), 1.0);
}
