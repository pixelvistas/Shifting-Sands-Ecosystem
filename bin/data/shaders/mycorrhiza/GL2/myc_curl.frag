// Prototype 2 (Mycorrhiza), style "Mycelium": swirl directions for the base texture
// Generated by tools/mycorrhiza_harness/gen_mycelium_shaders.py (edit there; GL2 and GL3 stay in sync).
// Port of tools/mycelium_lookdev/index.html (fsCurlField); tools/mycorrhiza_harness/mycelium.cpp has the same formulas in C++.
#version 120
#extension GL_ARB_texture_rectangle : enable

uniform sampler2DRect uMask;   // per cell: R lit, G age, B, A stroke direction
uniform sampler2DRect uAux;    // per cell: R model warming, G smoothed sand (mm)
uniform vec2 uRes, uMaskSize;
uniform float uScale, uSlopeW, uStrokeW;

varying vec2 px;

float hash12(vec2 p)
{
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

float vnoise(vec2 p)
{
	vec2 i = floor(p), f = p - i;
	vec2 u = f * f * (3.0 - 2.0 * f);
	float a = hash12(i), b = hash12(i + vec2(1.0, 0.0));
	float c = hash12(i + vec2(0.0, 1.0)), d = hash12(i + vec2(1.0, 1.0));
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

void main()
{
	vec2 uv = px / uRes;
	vec2 cp = px / uRes.y * uScale;
	float h = 0.01;
	vec2 c = vec2(vnoise(cp + vec2(0.0, h)) - vnoise(cp - vec2(0.0, h)), -(vnoise(cp + vec2(h, 0.0)) - vnoise(cp - vec2(h, 0.0)))) / (2.0 * h);
	c += 0.5 * vec2(vnoise(cp * 2.7 + vec2(3.0, 0.0)) - 0.5, vnoise(cp * 2.7 + vec2(0.0, 5.0)) - 0.5);
	vec2 t = uv * uMaskSize;
	vec2 g = 0.5 * vec2(texture2DRect(uAux, t + vec2(1.0, 0.0)).g - texture2DRect(uAux, t - vec2(1.0, 0.0)).g,
	                    texture2DRect(uAux, t + vec2(0.0, 1.0)).g - texture2DRect(uAux, t - vec2(0.0, 1.0)).g);
	float sl = length(g);
	vec2 dir = mix(c / (length(c) + 1e-4), -g / (sl + 1e-4), uSlopeW * smoothstep(0.05, 0.6, sl));
	vec4 m = texture2DRect(uMask, t);
	float ml = length(m.ba);
	if (ml > 1e-3) dir = mix(dir, m.ba / ml, uStrokeW * smoothstep(0.1, 0.5, m.r));
	gl_FragColor = vec4(dir, 0.0, 1.0);
}
