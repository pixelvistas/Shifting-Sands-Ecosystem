// Prototype 2 (Mycorrhiza), style "Mycelium": the texture rides on the liquid and runs along the stroke, settling back toward the base pattern
// Generated by tools/mycorrhiza_harness/gen_mycelium_shaders.py (edit there; GL2 and GL3 stay in sync).
// Port of tools/mycelium_lookdev/index.html (fsFib); tools/mycorrhiza_harness/mycelium.cpp has the same formulas in C++.
#version 120
#extension GL_ARB_texture_rectangle : enable

uniform sampler2DRect uFib, uBase, uLiq, uMask;
uniform vec2 uRes, uLiqSize, uMaskSize;
uniform float uDt, uRelax, uCarry, uStreakFlow;

varying vec2 px;

void main()
{
	vec2 uv = px / uRes;
	vec2 v = uCarry * texture2DRect(uLiq, uv * uLiqSize).gb / uLiqSize;     // liquid cells/s -> uv/s
	vec4 m = texture2DRect(uMask, uv * uMaskSize);
	float ml = length(m.ba);
	if (ml > 1e-3) v += uStreakFlow * m.r * (m.ba / ml) / uRes;   // px/s -> uv/s
	float f = texture2DRect(uFib, (uv - uDt * v) * uRes).r;
	float b = texture2DRect(uBase, px).r;
	gl_FragColor = vec4(mix(f, b, 1.0 - exp(-uDt * uRelax)), 0.0, 0.0, 1.0);
}
