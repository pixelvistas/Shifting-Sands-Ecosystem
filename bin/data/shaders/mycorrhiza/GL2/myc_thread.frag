// Prototype 2 (Mycorrhiza), style "Mycelium": threads: thin lines with light pulsing outward along them (R thread, G pulse)
// Generated by tools/mycorrhiza_harness/gen_mycelium_shaders.py (edit there; GL2 and GL3 stay in sync).
// Port of tools/mycelium_lookdev/index.html (fsThread); tools/mycorrhiza_harness/mycelium.cpp has the same formulas in C++.
#version 120
#extension GL_ARB_texture_rectangle : enable

uniform float uTime, uFade, uPulseSpeed, uPulseLen, uPulseSharp;

varying float vSide;
varying float vS;
varying float vPhase;
varying float vBirth;

void main()
{
	float core = exp(-vSide * vSide * 2.5);
	float fade = exp(-max(uTime - vBirth, 0.0) * uFade);
	float pulse = pow(0.5 + 0.5 * cos(6.2831853 * (vS / uPulseLen - uTime * uPulseSpeed + vPhase)), uPulseSharp);
	gl_FragColor = vec4(core * fade, core * fade * pulse, 0.0, 1.0);
}
