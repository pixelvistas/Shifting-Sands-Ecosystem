// Prototype 2 (Mycorrhiza), style "Mycelium": bloom: the part above the threshold
// Generated by tools/mycorrhiza_harness/gen_mycelium_shaders.py (edit there; GL2 and GL3 stay in sync).
// Port of tools/mycelium_lookdev/index.html (fsBright); tools/mycorrhiza_harness/main.cpp has the same formulas in C++.
#version 150

uniform sampler2DRect uSrc;
uniform vec2 uRes, uSrcSize;
uniform float uThresh;

in vec2 px;
out vec4 outputColor;

void main()
{
	vec3 c = texture(uSrc, px / uRes * uSrcSize).rgb;
	float br = max(c.r, max(c.g, c.b));
	outputColor = vec4(c * max(br - uThresh, 0.0) / max(br, 1e-4), 1.0);
}
