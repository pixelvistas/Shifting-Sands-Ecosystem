// Prototype 2 (Mycorrhiza), style "Mycelium": the finished image mapped onto the sand (projector calibration mesh)
// Generated by tools/mycorrhiza_harness/gen_mycelium_shaders.py (edit there; GL2 and GL3 stay in sync).
// Port of tools/mycelium_lookdev/index.html (-); tools/mycorrhiza_harness/main.cpp has the same formulas in C++.
#version 150

uniform sampler2DRect uImage;
uniform float uScale;          // image px per grid cell

in vec2 px;
out vec4 outputColor;

void main()
{
	outputColor = vec4(texture(uImage, px * uScale).rgb, 1.0);
}
