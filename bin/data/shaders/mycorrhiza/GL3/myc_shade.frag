// Prototype 2 (Mycorrhiza), style "Mycelium": shade the lit ground and the threads
// Generated by tools/mycorrhiza_harness/gen_mycelium_shaders.py (edit there; GL2 and GL3 stay in sync).
// Port of tools/mycelium_lookdev/index.html (fsShade); tools/mycorrhiza_harness/mycelium.cpp has the same formulas in C++.
#version 150

uniform sampler2DRect uMask;   // per cell: R lit, G age (s), B, A stroke direction
uniform sampler2DRect uAux;    // per cell: R model warming, G smoothed sand (mm)
uniform sampler2DRect uLiq;    // per liquid cell: R depth (mm)
uniform sampler2DRect uFib, uThreads;
uniform vec2 uRes, uMaskSize, uLiqSize;
uniform vec3 uThreadCol;
uniform float uEdgeCool, uFromModel;
uniform float uContrast, uGamma, uBase, uMature, uExposure, uSheen, uRelief, uShine, uRim, uSand, uFibRelief, uLightCol, uThreadBright, uPulseGain;
uniform vec3 uC0, uC1, uC2, uC3, uTrough;

in vec2 px;
out vec4 outputColor;

vec3 ramp(float m)
{
	m = clamp(m, 0.0, 1.0) * 3.0;
	if (m < 1.0) return mix(uC0, uC1, m);
	if (m < 2.0) return mix(uC1, uC2, m - 1.0);
	return mix(uC2, uC3, m - 2.0);
}

float surf(vec2 uv) { return texture(uAux, uv * uMaskSize).g + texture(uLiq, uv * uLiqSize).r; }

void main()
{
	vec2 uv = px / uRes;
	vec2 mt = uv * uMaskSize;
	vec4 mk = texture(uMask, mt);
	float P = smoothstep(0.05, 0.6, mk.r);
	float edge = smoothstep(0.02, 0.2, length(vec2(texture(uMask, mt + vec2(1.0, 0.0)).r - texture(uMask, mt - vec2(1.0, 0.0)).r,
	                                                texture(uMask, mt + vec2(0.0, 1.0)).r - texture(uMask, mt - vec2(0.0, 1.0)).r)));
	float fraw = texture(uFib, px).r;
	float fib = pow(clamp((fraw - 0.5) * uContrast + 0.5, 0.0, 1.0), uGamma);
	vec2 fg = vec2(texture(uFib, px + vec2(1.0, 0.0)).r - texture(uFib, px - vec2(1.0, 0.0)).r,
	               texture(uFib, px + vec2(0.0, 1.0)).r - texture(uFib, px - vec2(0.0, 1.0)).r);
	float warm = uFromModel > 0.5 ? texture(uAux, mt).r : 1.0 - exp(-mk.g / max(uMature, 0.1));
	float m = warm * (1.0 - uEdgeCool * edge);
	vec2 e = 1.0 / uLiqSize;
	vec2 g = vec2(surf(uv + vec2(e.x, 0.0)) - surf(uv - vec2(e.x, 0.0)), surf(uv + vec2(0.0, e.y)) - surf(uv - vec2(0.0, e.y)));
	vec3 n = normalize(vec3(-g * uRelief - fg * uFibRelief * uContrast, 1.0));
	vec3 Ld = normalize(vec3(-0.5, -0.55, 0.65));
	float diff = max(dot(n, Ld), 0.0);
	float spec = pow(max(dot(n, normalize(Ld + vec3(0.0, 0.0, 1.0))), 0.0), uShine) * uSheen;
	float lightKey = clamp(0.85 * diff + 0.35 * fib - 0.2, 0.0, 1.0);
	float key = mix(m * (0.55 + 0.45 * fib), lightKey, uLightCol);
	vec3 col = mix(uTrough, ramp(key), smoothstep(0.0, 0.6, fib)) * (uBase + fib) * (0.75 + 0.35 * diff) * P * uExposure;
	col += spec * mix(uC1, uC2, uLightCol) * P + uRim * edge * uC1 * P;
	vec2 th = texture(uThreads, px).rg;
	float T = min(th.r, 1.0), Pu = min(th.g, 1.0);
	vec3 tcol = uThreadCol * uThreadBright + ramp(0.55 + 0.45 * Pu) * Pu * uPulseGain;
	col += tcol * T * uExposure;
	vec2 tg = vec2(texture(uAux, mt + vec2(1.0, 0.0)).g - texture(uAux, mt - vec2(1.0, 0.0)).g,
	               texture(uAux, mt + vec2(0.0, 1.0)).g - texture(uAux, mt - vec2(0.0, 1.0)).g);
	vec3 sn = normalize(vec3(-tg * 0.35, 1.0));
	float shade = max(0.0, dot(sn, normalize(vec3(-0.5, -0.6, 0.65))));
	col += vec3(0.36, 0.32, 0.27) * (0.35 + 0.65 * shade) * uSand * (1.0 - P);
	outputColor = vec4(col, 1.0);
}
