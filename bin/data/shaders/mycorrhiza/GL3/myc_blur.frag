// Prototype 2 (Mycorrhiza), style "Mycelium": bloom: separable 5-tap Gaussian (uStep in uv, as the page)
// Generated by tools/mycorrhiza_harness/gen_mycelium_shaders.py (edit there; GL2 and GL3 stay in sync).
// Port of tools/mycelium_lookdev/index.html (fsBlur); tools/mycorrhiza_harness/mycelium.cpp has the same formulas in C++.
#version 150

uniform sampler2DRect uSrc;
uniform vec2 uRes, uSrcSize, uStep;

in vec2 px;
out vec4 outputColor;

vec3 S(vec2 uv) { return texture(uSrc, uv * uSrcSize).rgb; }

void main()
{
	vec2 uv = px / uRes;
	vec3 c = S(uv) * 0.2270270;
	c += (S(uv + uStep * 1.3846154) + S(uv - uStep * 1.3846154)) * 0.3162162;
	c += (S(uv + uStep * 3.2307692) + S(uv - uStep * 3.2307692)) * 0.0702703;
	outputColor = vec4(c, 1.0);
}
