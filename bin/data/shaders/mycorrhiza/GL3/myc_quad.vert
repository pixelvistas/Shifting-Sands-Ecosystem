// Prototype 2 (Mycorrhiza), style "Mycelium": full-screen pass; px = this pass's pixel coordinate (texcoord)
// Generated by tools/mycorrhiza_harness/gen_mycelium_shaders.py (edit there; GL2 and GL3 stay in sync).
// Port of tools/mycelium_lookdev/index.html (vs); tools/mycorrhiza_harness/mycelium.cpp has the same formulas in C++.
#version 150

uniform mat4 modelViewProjectionMatrix;

in vec4 position;
in vec2 texcoord;

out vec2 px;

void main()
{
	px = texcoord;
	gl_Position = modelViewProjectionMatrix * position;
}
