// Prototype 2 (Mycorrhiza), style "Mycelium": thread segments as quads
// Generated by tools/mycorrhiza_harness/gen_mycelium_shaders.py (edit there; GL2 and GL3 stay in sync).
// Port of tools/mycelium_lookdev/index.html (vsThread); tools/mycorrhiza_harness/main.cpp has the same formulas in C++.
#version 150

uniform mat4 modelViewProjectionMatrix;

in vec4 position;   // fibre px
in vec2 texcoord;   // side (-1.5 .. 1.5), arc length s (px)
in vec4 normal;     // phase, birth (s), hue

out float vSide;
out float vS;
out float vPhase;
out float vBirth;

void main()
{
	vSide = texcoord.x; vS = texcoord.y; vPhase = normal.x; vBirth = normal.y;
	gl_Position = modelViewProjectionMatrix * position;
}
