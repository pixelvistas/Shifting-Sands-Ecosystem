// Prototype 2 (Mycorrhiza), style "Mycelium": bloom and exponential tone map
// Generated by tools/mycorrhiza_harness/gen_mycelium_shaders.py (edit there; GL2 and GL3 stay in sync).
// Port of tools/mycelium_lookdev/index.html (fsFinal); tools/mycorrhiza_harness/main.cpp has the same formulas in C++.
#version 150

uniform sampler2DRect uShade, uBloomA, uBloomB;
uniform vec2 uRes, uSizeA, uSizeB;
uniform float uBloom;

in vec2 px;
out vec4 outputColor;

void main()
{
	vec2 uv = px / uRes;
	vec3 c = texture(uShade, px).rgb + uBloom * (texture(uBloomA, uv * uSizeA).rgb + 0.6 * texture(uBloomB, uv * uSizeB).rgb);
	c = vec3(1.0) - exp(-c * 1.35);
	outputColor = vec4(pow(c, vec3(0.95)), 1.0);
}
