// Prototype 2 (Mycorrhiza), style "Mycelium": line integral convolution: soft noise averaged along the swirls (fine combed fibres)
// Generated by tools/mycorrhiza_harness/gen_mycelium_shaders.py (edit there; GL2 and GL3 stay in sync).
// Port of tools/mycelium_lookdev/index.html (fsLic); tools/mycorrhiza_harness/mycelium.cpp has the same formulas in C++.
#version 150

uniform sampler2DRect uVel;    // swirl directions
uniform sampler2D uNoise;      // 256 x 256 random bytes, repeat
uniform vec2 uRes, uVelSize;
uniform float uLen, uFibre;

in vec2 px;
out vec4 outputColor;

float nz(vec2 p) { return texture(uNoise, p / (256.0 * uFibre)).r; }

void main()
{
	vec2 p0 = px;
	float ds = max(0.7 * uFibre, uLen / 48.0);
	float acc = 0.5 * nz(p0), ws = 0.5;
	for (int dir = -1; dir <= 1; dir += 2) {
		vec2 p = p0;
		for (int i = 0; i < 48; i++) {
			if (float(i + 1) * ds > uLen) break;
			vec2 v = texture(uVel, p / uRes * uVelSize).xy;
			float l = length(v);
			if (l < 1e-4) break;
			p += float(dir) * v / l * ds;
			float w = 1.0 - float(i + 1) * ds / uLen;
			acc += w * nz(p);
			ws += w;
		}
	}
	outputColor = vec4(acc / ws, 0.0, 0.0, 1.0);
}
